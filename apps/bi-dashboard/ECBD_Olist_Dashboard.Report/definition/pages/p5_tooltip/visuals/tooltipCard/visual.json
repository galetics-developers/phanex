{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "tooltipCard",
  "position": {
    "x": 8,
    "y": 8,
    "z": 1000,
    "height": 224,
    "width": 304,
    "tabOrder": 1
  },
  "visual": {
    "visualType": "cardVisual",
    "query": {
      "queryState": {
        "Data": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "GMV"
                }
              },
              "queryRef": "_Measures.GMV",
              "nativeQueryRef": "GMV",
              "displayName": "GMV (R$)"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Orders"
                }
              },
              "queryRef": "_Measures.Orders",
              "nativeQueryRef": "Orders",
              "displayName": "Orders"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Late Rate %"
                }
              },
              "queryRef": "_Measures.Late Rate %",
              "nativeQueryRef": "Late Rate %",
              "displayName": "Late rate"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Avg Review"
                }
              },
              "queryRef": "_Measures.Avg Review",
              "nativeQueryRef": "Avg Review",
              "displayName": "Average review"
            }
          ]
        }
      }
    },
    "objects": {
      "layout": [
        {
          "properties": {
            "maxTiles": {
              "expr": {
                "Literal": {
                  "Value": "2L"
                }
              }
            }
          }
        }
      ],
      "value": [
        {
          "properties": {
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "16D"
                }
              }
            },
            "fontFamily": {
              "expr": {
                "Literal": {
                  "Value": "'Segoe UI Semibold'"
                }
              }
            },
            "fontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#1A1A1A'"
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "label": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "10D"
                }
              }
            },
            "fontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#5D5B54'"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "id": "default"
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Tooltip card: GMV, orders, late rate and review of the point'"
                }
              }
            }
          }
        }
      ],
      "border": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "dropShadow": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "background": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "color": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#FFFFFF'"
                    }
                  }
                }
              }
            },
            "transparency": {
              "expr": {
                "Literal": {
                  "Value": "0D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}