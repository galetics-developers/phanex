	/// Readable English label of delay_band (blank when the order was not evaluated), sorted by delay_band_order.
	column delay_band_name = SWITCH ( fact_order_items[delay_band_order], 1, "10+ days early", 2, "1 to 9 days early", 3, "On time to 3 days late", 4, "4 to 10 days late", 5, "Over 10 days late" )
		dataType: string
		lineageTag: 50144948-4c9c-45b4-a0f6-513da379a448
		summarizeBy: none
		sortByColumn: delay_band_order

	partition fact_order_items = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataPath & "fact_order_items.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    EmptyToNull = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(EmptyToNull, {
				        {"order_item_key", Int64.Type}, {"order_id", type text}, {"order_item_id", Int64.Type},
				        {"purchase_date_key", Int64.Type}, {"delivered_date_key", Int64.Type}, {"estimated_date_key", Int64.Type},
				        {"customer_key", Int64.Type}, {"customer_state_key", Int64.Type}, {"seller_key", Int64.Type},
				        {"product_key", Int64.Type}, {"payment_type_key", Int64.Type}, {"order_status_key", Int64.Type},
				        {"price", Currency.Type}, {"freight_value", Currency.Type}, {"item_total", Currency.Type},
				        {"freight_ratio", type number}, {"payment_value_order", Currency.Type}, {"installments", Int64.Type},
				        {"purchase_hour", Int64.Type}, {"delivery_days", type number}, {"promised_days", type number},
				        {"delay_days", Int64.Type}, {"is_late", Int64.Type}, {"delay_band", type text},
				        {"delay_band_order", Int64.Type}, {"delivery_data_missing", Int64.Type}, {"review_score", Int64.Type},
				        {"is_negative_review", Int64.Type}, {"distance_km", type number}, {"same_state", Int64.Type}
				    }, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

