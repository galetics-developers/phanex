	column state_name = LOOKUPVALUE(dim_state[state_name], dim_state[uf], dim_customer[state])
		dataType: string
		lineageTag: 2ba27907-3598-4b80-936a-3035a63bee3c
		dataCategory: StateOrProvince
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column state_full = dim_customer[state_name] & ", Brazil"
		dataType: string
		lineageTag: 9be6845c-a4a0-477e-8cb7-49032d3ae108
		dataCategory: StateOrProvince
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// English display name of the customer region (Norte = North, Nordeste = Northeast, Centro-Oeste = Central-West, Sudeste = Southeast, Sul = South). Used in slicers, axes and the Customer geography hierarchy.
	column region_name = SWITCH ( dim_customer[region], "Norte", "North", "Nordeste", "Northeast", "Centro-Oeste", "Central-West", "Sudeste", "Southeast", "Sul", "South", dim_customer[region] )
		dataType: string
		lineageTag: c727020f-9eec-4b70-898d-d3e3ae87dc35
		summarizeBy: none

	hierarchy 'Customer geography'
		lineageTag: 4cb2b16b-38bd-4b2e-9bb9-5e26b96fe534

		level Region
			lineageTag: ce593d49-f431-4aad-819b-fb947372e85e
			column: region_name

		level State
			lineageTag: 4e694ceb-dc82-4487-af0a-b481719a9382
			column: state_full

		level City
			lineageTag: 2f628b4b-515e-4a1f-b57d-af48f842c8df
			column: city

	partition dim_customer = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataPath & "dim_customer.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    EmptyToNull = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(EmptyToNull, {
				        {"customer_key", Int64.Type}, {"customer_id", type text}, {"customer_unique_id", type text},
				        {"city", type text}, {"state", type text}, {"region", type text}, {"zip_prefix", type text},
				        {"lat", type number}, {"lng", type number}
				    }, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

