	/// Display name of the product macro category (uncategorized shown as Uncategorized).
	column macro_name = IF ( dim_product[macro_category] = "uncategorized", "Uncategorized", dim_product[macro_category] )
		dataType: string
		lineageTag: 0b07a390-3a6b-4f43-965b-f4a642105bdb
		summarizeBy: none

	/// Display name of the product category: category_en with spaces instead of underscores and a capital first letter.
	column category_name = VAR _t = SUBSTITUTE ( dim_product[category_en], "_", " " ) RETURN UPPER ( LEFT ( _t, 1 ) ) & MID ( _t, 2, 200 )
		dataType: string
		lineageTag: adc799b3-ccdc-4c5e-b670-593a073b3999
		summarizeBy: none

	hierarchy Product
		lineageTag: b670ea5a-842f-4995-b2ec-9268c5ba643e

		level 'Macro category'
			lineageTag: 528b8997-c0bb-48bc-ae68-0b3eece11902
			column: macro_name

		level Category
			lineageTag: 524ebfd7-6f72-4b82-a56f-fbc7a3d119eb
			column: category_name

	partition dim_product = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataPath & "dim_product.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    EmptyToNull = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(EmptyToNull, {
				        {"product_key", Int64.Type}, {"product_id", type text}, {"category_pt", type text},
				        {"category_en", type text}, {"macro_category", type text}, {"weight_g", type number},
				        {"volume_cm3", type number}, {"photos_qty", Int64.Type}, {"dims_imputed", Int64.Type}
				    }, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

