table _Measures
	lineageTag: b910f53b-dbd6-464b-a0bb-83924f9b5a97

	/// Gross merchandise value: sum of item price (not item_total; freight excluded) over non-canceled orders. Line level.
	measure GMV = CALCULATE ( SUM ( fact_order_items[price] ), KEEPFILTERS ( dim_order_status[order_status] <> "canceled" ) )
		formatString: \R\$ #,0;-\R\$ #,0;\R\$ #,0
		displayFolder: Commercial
		lineageTag: c5a844c9-008e-4985-8450-5cdad68275b8

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Sum of freight_value over non-canceled orders. Line level.
	measure Freight = CALCULATE ( SUM ( fact_order_items[freight_value] ), KEEPFILTERS ( dim_order_status[order_status] <> "canceled" ) )
		formatString: \R\$ #,0;-\R\$ #,0;\R\$ #,0
		displayFolder: Commercial
		lineageTag: f31503a6-2597-4f5a-93dc-fc5e5400004e

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Freight divided by GMV in the current context (non-canceled orders).
	measure 'Freight Ratio' = DIVIDE ( [Freight], [GMV] )
		formatString: 0.0%
		displayFolder: Commercial
		lineageTag: efdbc141-34e2-46cc-a88c-fff55f67202c

	/// Distinct count of order_id excluding canceled orders (distinct count because the fact grain is one order line).
	measure Orders = CALCULATE ( DISTINCTCOUNT ( fact_order_items[order_id] ), KEEPFILTERS ( dim_order_status[order_status] <> "canceled" ) )
		formatString: #,0
		displayFolder: Commercial
		lineageTag: c2bc1ccf-3586-4bcc-be1e-365262d99d90

	/// Distinct count of order_id across all order statuses, canceled included.
	measure 'All Orders' = DISTINCTCOUNT ( fact_order_items[order_id] )
		formatString: #,0
		displayFolder: Commercial
		lineageTag: 7784c33e-96bc-4796-b3d5-3ccd5da84535

	/// Number of order lines (rows of fact_order_items), all order statuses.
	measure Items = COUNTROWS ( fact_order_items )
		formatString: #,0
		displayFolder: Commercial
		lineageTag: 0ed3dc92-ce2f-4a56-b5e4-a801023eefd2

	/// (GMV + Freight) / Orders. Under a category or seller context this is a partial ticket: it only adds the lines of that category or seller, not the whole order.
	measure 'Avg Ticket' = DIVIDE ( [GMV] + [Freight], [Orders] )
		formatString: \R\$ #,0;-\R\$ #,0;\R\$ #,0
		displayFolder: Commercial
		lineageTag: 4e1bf860-c7d7-4ed9-a5f6-d30ecb847525

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Distinct customer_unique_id of the customers with order lines in the context (filtered through the fact table, no bidirectional relationship). All order statuses.
	measure Customers = CALCULATE ( DISTINCTCOUNT ( dim_customer[customer_unique_id] ), fact_order_items )
		formatString: #,0
		displayFolder: Commercial
		lineageTag: b6d14911-165b-4a1b-9966-9d120a53dbf9

	/// 2018 IBGE population of the customer states with order lines in the context (filtered through the fact table, no bidirectional relationship).
	measure Population = CALCULATE ( SUM ( dim_state[population_2018] ), fact_order_items )
		formatString: #,0
		displayFolder: Penetration
		lineageTag: 5b3346ec-bce6-4292-b691-dff34e2d8e87

	/// Orders per 100,000 inhabitants: Orders * 100,000 / Population.
	measure 'Orders per 100k' = DIVIDE ( [Orders] * 100000, [Population] )
		formatString: #,0.0
		displayFolder: Penetration
		lineageTag: ed616821-6e5e-497e-9628-3d559f647eeb

	/// Distinct orders with a non-blank is_late flag (delivered orders with a valid delivery date). Denominator of Late Rate %.
	measure 'Evaluated Orders' = CALCULATE ( DISTINCTCOUNT ( fact_order_items[order_id] ), KEEPFILTERS ( NOT ISBLANK ( fact_order_items[is_late] ) ) )
		formatString: #,0
		displayFolder: Logistics
		lineageTag: 755a3315-ddee-4e8a-8982-e8c3d7621fde

	/// Distinct orders delivered after the estimated date (is_late = 1).
	measure 'Late Orders' = CALCULATE ( DISTINCTCOUNT ( fact_order_items[order_id] ), KEEPFILTERS ( fact_order_items[is_late] = 1 ) )
		formatString: #,0
		displayFolder: Logistics
		lineageTag: 7369eb02-3200-4073-ab52-2ac4ebdcb77b

	/// Late Orders / Evaluated Orders. Blank when there are no evaluated orders; 0 when there are evaluated orders but none is late.
	measure 'Late Rate %' =
			VAR _den = [Evaluated Orders]
			RETURN IF ( _den > 0, DIVIDE ( COALESCE ( [Late Orders], 0 ), _den ) )
		formatString: 0.0%
		displayFolder: Logistics
		lineageTag: e4561c6a-6d7e-48ed-9828-d1de770b3bd9

	/// Average delivery_days per order (one value per order: MAX over its lines); orders without a value are ignored.
	measure 'Avg Delivery Days' = AVERAGEX ( VALUES ( fact_order_items[order_id] ), CALCULATE ( MAX ( fact_order_items[delivery_days] ) ) )
		formatString: 0.0
		displayFolder: Logistics
		lineageTag: 9c7a836b-26ee-4d65-a0a9-d3848580b8c9

	/// Average delay_days per order (delivered minus estimated date; negative = earlier than promised); orders without a value are ignored.
	measure 'Avg Delay Days' = AVERAGEX ( VALUES ( fact_order_items[order_id] ), CALCULATE ( MAX ( fact_order_items[delay_days] ) ) )
		formatString: 0.0
		displayFolder: Logistics
		lineageTag: fe11fdd9-6fa6-4238-b280-44939a2400a4

	/// Average customer-seller haversine distance per order (MAX of distance_km over its lines); lines with a blank distance are ignored.
	measure 'Avg Distance km' = AVERAGEX ( VALUES ( fact_order_items[order_id] ), CALCULATE ( MAX ( fact_order_items[distance_km] ) ) )
		formatString: #,0.0
		displayFolder: Logistics
		lineageTag: 0b4ce7b0-d56a-44ce-9826-7d436b3a8cf1

	/// Average review_score per order (one value per order); orders without a review are ignored. All order statuses.
	measure 'Avg Review' = AVERAGEX ( VALUES ( fact_order_items[order_id] ), CALCULATE ( MAX ( fact_order_items[review_score] ) ) )
		formatString: 0.00
		displayFolder: Satisfaction
		lineageTag: 0b6aa423-eea6-4e37-a0e5-b2054ef6a7a3

	/// Distinct orders with a non-blank review_score. Denominator of Negative Review %. All order statuses.
	measure 'Reviewed Orders' = CALCULATE ( DISTINCTCOUNT ( fact_order_items[order_id] ), KEEPFILTERS ( NOT ISBLANK ( fact_order_items[review_score] ) ) )
		formatString: #,0
		displayFolder: Satisfaction
		lineageTag: 29c22944-18a7-4b4a-a31e-2ff29030eb0e

	/// Orders with a negative review (is_negative_review = 1) / Reviewed Orders. Blank without reviewed orders; 0 when none is negative.
	measure 'Negative Review %' =
			VAR _den = [Reviewed Orders]
			VAR _num = CALCULATE ( DISTINCTCOUNT ( fact_order_items[order_id] ), KEEPFILTERS ( fact_order_items[is_negative_review] = 1 ) )
			RETURN IF ( _den > 0, DIVIDE ( COALESCE ( _num, 0 ), _den ) )
		formatString: 0.0%
		displayFolder: Satisfaction
		lineageTag: 34639f58-d794-4c6d-bf09-c0f3e2ab2b9b

	/// Avg Review in context minus the national Avg Review (customer geography filters on dim_customer and dim_state removed, all other filters kept). Blank if either term is blank.
	measure 'Review Gap vs National' =
			VAR _local = [Avg Review]
			VAR _national = CALCULATE ( [Avg Review], REMOVEFILTERS ( dim_customer ), REMOVEFILTERS ( dim_state ) )
			RETURN IF ( NOT ISBLANK ( _local ) && NOT ISBLANK ( _national ), _local - _national )
		formatString: 0.00
		displayFolder: Satisfaction
		lineageTag: 86f489c3-4cbb-4537-9330-43371ecd007c

	/// GMV (non-canceled orders) of late orders (is_late = 1).
	measure 'Late GMV' = CALCULATE ( [GMV], KEEPFILTERS ( fact_order_items[is_late] = 1 ) )
		formatString: \R\$ #,0;-\R\$ #,0;\R\$ #,0
		displayFolder: Cost
		lineageTag: 75f3fb52-bb6b-4e86-9f95-749ff18711d6

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Late GMV / GMV of evaluated orders (is_late not blank): % of delivered GMV; excludes deliveries without a valid date. 0 when there is evaluated GMV but no late GMV.
	measure 'Late GMV %' =
			VAR _den = CALCULATE ( [GMV], KEEPFILTERS ( NOT ISBLANK ( fact_order_items[is_late] ) ) )
			RETURN IF ( _den > 0, DIVIDE ( COALESCE ( [Late GMV], 0 ), _den ) )
		formatString: 0.0%
		displayFolder: Cost
		lineageTag: f63b3c21-e19e-4def-9ba2-5749dab73e2e

	/// Avg Review of orders delivered on time (is_late = 0). Strict equality (==) so orders with a blank is_late (not evaluated) are excluded: in DAX BLANK = 0 is true.
	measure 'Avg Review On Time' = CALCULATE ( [Avg Review], KEEPFILTERS ( fact_order_items[is_late] == 0 ) )
		formatString: 0.00
		displayFolder: Cost
		lineageTag: 2fb18d07-a63a-4689-b3c7-345e3f22e7dd

	/// Avg Review of late orders (is_late = 1).
	measure 'Avg Review Late' = CALCULATE ( [Avg Review], KEEPFILTERS ( fact_order_items[is_late] = 1 ) )
		formatString: 0.00
		displayFolder: Cost
		lineageTag: dffdcdac-30a8-4269-bf89-35ab2062ca44

	/// Avg Review On Time minus Avg Review Late (review points lost with a late delivery). Blank if either term is blank.
	measure 'Review Drop Late' =
			VAR _on = [Avg Review On Time]
			VAR _late = [Avg Review Late]
			RETURN IF ( NOT ISBLANK ( _on ) && NOT ISBLANK ( _late ), _on - _late )
		formatString: 0.00
		displayFolder: Cost
		lineageTag: bb39a252-4264-4961-9ea0-05f6b5a4dffd

	/// Negative Review % among late orders (is_late = 1).
	measure 'Negative Review % Late' = CALCULATE ( [Negative Review %], KEEPFILTERS ( fact_order_items[is_late] = 1 ) )
		formatString: 0.0%
		displayFolder: Cost
		lineageTag: 3a254853-afd4-4257-b145-29609010d32d

	/// Negative Review % among orders delivered on time (is_late = 0). Strict equality (==) so orders with a blank is_late (not evaluated) are excluded.
	measure 'Negative Review % On Time' = CALCULATE ( [Negative Review %], KEEPFILTERS ( fact_order_items[is_late] == 0 ) )
		formatString: 0.0%
		displayFolder: Cost
		lineageTag: 2b0606e7-f488-4dec-9ece-2071a42580e0

	/// Share of active customers (distinct customer_unique_id with at least one non-canceled order in the filtered context) that have 2 or more non-canceled orders in the same context. Does not use Customers as denominator. Priority P2.
	measure 'Repeat Customer Rate' =
			VAR _customers =
			    CALCULATETABLE (
			        ADDCOLUMNS (
			            SUMMARIZE ( fact_order_items, dim_customer[customer_unique_id] ),
			            "@orders", CALCULATE ( DISTINCTCOUNT ( fact_order_items[order_id] ) )
			        ),
			        KEEPFILTERS ( dim_order_status[order_status] <> "canceled" )
			    )
			VAR _active = COUNTROWS ( _customers )
			VAR _repeat = COUNTROWS ( FILTER ( _customers, [@orders] >= 2 ) )
			RETURN IF ( _active > 0, DIVIDE ( COALESCE ( _repeat, 0 ), _active ) )
		formatString: 0.0%
		displayFolder: Cost
		lineageTag: aa9d52b5-b1e7-40b4-9d64-21f72175a439

	/// GMV for the same period of the previous year (SAMEPERIODLASTYEAR on the marked date table dim_date). Under year 2018 it compares against full-year 2017.
	measure 'GMV PY' = CALCULATE ( [GMV], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: \R\$ #,0;-\R\$ #,0;\R\$ #,0
		displayFolder: Time
		lineageTag: 154e3234-48b8-44e8-b90c-25711ca87dc5

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// (GMV - GMV PY) / GMV PY. Blank when GMV is blank or there is no previous-year GMV (never -100%).
	measure 'GMV YoY %' =
			VAR _cur = [GMV]
			VAR _py = [GMV PY]
			RETURN IF ( NOT ISBLANK ( _cur ), DIVIDE ( _cur - _py, _py ) )
		formatString: 0.0%
		displayFolder: Time
		lineageTag: a043c93a-e181-4560-88c1-789faa959999

	/// Orders by delivery date: activates the inactive delivered_date_key relationship with dim_date only inside this measure.
	measure 'Orders by Delivery Date' = CALCULATE ( [Orders], USERELATIONSHIP ( fact_order_items[delivered_date_key], dim_date[date_key] ) )
		formatString: #,0
		displayFolder: Time
		lineageTag: 226be5ef-a6d6-47fd-8956-548d2e4e091f

	/// Orders by estimated delivery date: activates the inactive estimated_date_key relationship with dim_date only inside this measure.
	measure 'Orders by Estimated Date' = CALCULATE ( [Orders], USERELATIONSHIP ( fact_order_items[estimated_date_key], dim_date[date_key] ) )
		formatString: #,0
		displayFolder: Time
		lineageTag: 84fa7078-cb74-4351-b94f-ffca2753568a

	/// Late-rate target selected in the Late rate target parameter (0-20%, step 1%); 8% when nothing is selected. The target is a team assumption, not Olist data.
	measure 'Late Rate Target' = SELECTEDVALUE ( 'Late Rate Target'[Target], 0.08 )
		formatString: 0.0%
		displayFolder: Target
		lineageTag: 095fd326-3f39-4bdd-b948-1ed08fee4be6

	/// Late Rate Target minus Late Rate % (+ = better than target); blank when Late Rate % is blank. The value is a fraction shown in percentage points (pp): the static format +0.0% displays it with a % sign, so titles and axes say pp.
	measure 'Late Rate Variance' =
			VAR _rate = [Late Rate %]
			RETURN IF ( NOT ISBLANK ( _rate ), [Late Rate Target] - _rate )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Target
		lineageTag: 72895b4e-0679-4959-a533-1494f1190d98

	/// Status of Late Rate % against the target, e.g. below target by 1.2 pp; shown in the page 1 KPI card subtitle; blank when Late Rate % is blank. Colour comes from a conditional formatting rule, not from this measure.
	measure 'Late Rate Status' =
			VAR _rate = [Late Rate %]
			VAR _target = [Late Rate Target]
			VAR _pp = ABS ( _rate - _target ) * 100
			RETURN IF ( NOT ISBLANK ( _rate ),
			    IF ( _rate > _target,
			        "above target by " & FORMAT ( _pp, "0.0", "en-US" ) & " pp",
			        "below target by " & FORMAT ( _pp, "0.0", "en-US" ) & " pp" ) )
		displayFolder: Presentation
		lineageTag: 02debde0-aa09-4291-8f1f-22703cafd9f1

	/// 1/0 flag: 1 when the hidden is_late slicer (Show late orders only) filters is_late = 1, otherwise 0. Base of Late Filter Badge and of the fill rule of the badge on the visible pages and State detail.
	measure 'Late Filter Active' = IF ( ISFILTERED ( fact_order_items[is_late] ) && SELECTEDVALUE ( fact_order_items[is_late] ) = 1, 1, 0 )
		formatString: 0
		displayFolder: Presentation
		lineageTag: 57e69303-86ab-45dd-886f-7599f2b41e36

	/// Badge text 'Filter: late only' shown in the band of the visible pages and State detail while the late-only filter is active; blank otherwise.
	measure 'Late Filter Badge' = IF ( [Late Filter Active] = 1, "Filter: late only" )
		displayFolder: Presentation
		lineageTag: 8fc7f4bf-39a3-43fc-9606-f2f530203dad

	/// Title of the hidden State detail drill-through page: 'State detail: ' plus the state name in context, or 'multiple states'.
	measure 'State Detail Title' = "State detail: " & SELECTEDVALUE ( dim_customer[state_name], "multiple states" )
		displayFolder: Presentation
		lineageTag: bb4aa224-734c-42ee-9ee0-741f421b6fc9

	/// Rank by Late Rate % (descending) among the members of the current Customer geography level (region, state_full or city) with at least 30 Evaluated Orders; ties by Evaluated Orders descending, then name ascending (state_full order equals state_name order because the suffix is constant). Blank below the minimum. Visual filter of the page 1 top 10 bars and base of Top 3 Flag.
	measure 'State Late Rank' =
			VAR _min = 30
			VAR _rate = [Late Rate %]
			VAR _eval = [Evaluated Orders]
			RETURN
			IF ( _eval >= _min,
			    SWITCH ( TRUE (),
			        ISINSCOPE ( dim_customer[city] ),
			            VAR _cur = SELECTEDVALUE ( dim_customer[city] )
			            VAR _t = FILTER ( ADDCOLUMNS ( ALLSELECTED ( dim_customer[city] ), "@r", [Late Rate %], "@e", [Evaluated Orders] ), [@e] >= _min )
			            RETURN 1 + COUNTROWS ( FILTER ( _t, [@r] > _rate || ( [@r] = _rate && [@e] > _eval ) || ( [@r] = _rate && [@e] = _eval && dim_customer[city] < _cur ) ) ),
			        ISINSCOPE ( dim_customer[state_full] ),
			            VAR _cur = SELECTEDVALUE ( dim_customer[state_full] )
			            VAR _t = FILTER ( ADDCOLUMNS ( ALLSELECTED ( dim_customer[state_full] ), "@r", [Late Rate %], "@e", [Evaluated Orders] ), [@e] >= _min )
			            RETURN 1 + COUNTROWS ( FILTER ( _t, [@r] > _rate || ( [@r] = _rate && [@e] > _eval ) || ( [@r] = _rate && [@e] = _eval && dim_customer[state_full] < _cur ) ) ),
			        ISINSCOPE ( dim_customer[region_name] ),
			            VAR _cur = SELECTEDVALUE ( dim_customer[region_name] )
			            VAR _t = FILTER ( ADDCOLUMNS ( ALLSELECTED ( dim_customer[region_name] ), "@r", [Late Rate %], "@e", [Evaluated Orders] ), [@e] >= _min )
			            RETURN 1 + COUNTROWS ( FILTER ( _t, [@r] > _rate || ( [@r] = _rate && [@e] > _eval ) || ( [@r] = _rate && [@e] = _eval && dim_customer[region_name] < _cur ) ) ) ) )
		formatString: 0
		displayFolder: Presentation
		lineageTag: d86f0901-d461-4e8b-a3c4-7a5deed32109

	/// Number of members of the current Customer geography level (region, state_full or city) with at least 30 Evaluated Orders in the context. Decides whether the worst 3 are highlighted (> 3 eligible) and feeds Top10 Late Subtitle.
	measure 'Eligible Late States' =
			SWITCH ( TRUE (),
			    ISINSCOPE ( dim_customer[city] ), COUNTROWS ( FILTER ( ALLSELECTED ( dim_customer[city] ), [Evaluated Orders] >= 30 ) ),
			    ISINSCOPE ( dim_customer[state_full] ), COUNTROWS ( FILTER ( ALLSELECTED ( dim_customer[state_full] ), [Evaluated Orders] >= 30 ) ),
			    COUNTROWS ( FILTER ( ALLSELECTED ( dim_customer[region_name] ), [Evaluated Orders] >= 30 ) ) )
		formatString: #,0
		displayFolder: Presentation
		lineageTag: 3438b5c9-f851-404b-8722-e85cfa06d490

	/// 1/0 flag: 1 when there are more than 3 eligible members and State Late Rank <= 3, otherwise 0. Conditional formatting rule of the bar colour of the page 1 top 10 bars (accent on the worst 3).
	measure 'Top 3 Flag' = IF ( [Eligible Late States] > 3 && NOT ISBLANK ( [State Late Rank] ) && [State Late Rank] <= 3, 1, 0 )
		formatString: 0
		displayFolder: Presentation
		lineageTag: 9d7d0feb-800b-4466-af7e-56988e037764

	/// Text 'n sellers without coordinates': sellers with order lines in the context whose lat or lng is blank. Note of the page 3 seller bubble map; reused by Sellers Map Subtitle.
	measure 'Sellers Without Coords Note' =
			VAR _n = CALCULATE ( COUNTROWS ( dim_seller ), fact_order_items,
			             KEEPFILTERS ( FILTER ( ALL ( dim_seller[lat], dim_seller[lng] ), ISBLANK ( dim_seller[lat] ) || ISBLANK ( dim_seller[lng] ) ) ) )
			RETURN FORMAT ( COALESCE ( _n, 0 ), "#,0", "en-US" ) & " sellers without coordinates"
		displayFolder: Presentation
		lineageTag: df342de4-7b15-475e-bebf-9046bd066fac

	/// Fixed text explaining the Late GMV share denominator; subtitle of the State detail key figures card.
	measure 'Late GMV Note' = "Share of delivered GMV, excludes deliveries without a valid date"
		displayFolder: Presentation
		lineageTag: 687234e5-acf9-4a2a-b068-311133164fcb

	/// GMV only at the axis point whose dates contain 2017-11-24, blank elsewhere: auxiliary annotation series of the page 1 monthly GMV line (C-13 fallback: a categorical month axis has no constant X-axis line).
	measure 'Black Friday GMV Point' = IF ( MIN ( dim_date[date] ) <= DATE ( 2017, 11, 24 ) && MAX ( dim_date[date] ) >= DATE ( 2017, 11, 24 ), [GMV] )
		formatString: \R\$ #,0;-\R\$ #,0;\R\$ #,0
		displayFolder: Presentation
		lineageTag: 7c84109a-b327-4e97-9e60-88fd6625dcab

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	/// Late Rate % only at the axis point whose dates contain 2017-11-24, blank elsewhere: auxiliary annotation series of the page 1 monthly Late Rate % line (C-13 fallback: a categorical month axis has no constant X-axis line).
	measure 'Black Friday Late Rate Point' = IF ( MIN ( dim_date[date] ) <= DATE ( 2017, 11, 24 ) && MAX ( dim_date[date] ) >= DATE ( 2017, 11, 24 ), [Late Rate %] )
		formatString: 0.0%
		displayFolder: Presentation
		lineageTag: ae2d1372-a737-48ce-8a38-950018ab4a02

	/// Dynamic subtitle of the page 1 multi-row KPI card: Orders and Late Rate Target in context. Text only; FORMAT uses en-US.
	measure 'KPI Card Subtitle' = "Current filters: " & FORMAT ( [Orders], "#,0", "en-US" ) & " orders | late rate " & FORMAT ( [Late Rate %], "0.0%", "en-US" ) & ", " & [Late Rate Status] & " (target " & FORMAT ( [Late Rate Target], "0%", "en-US" ) & ")"
		displayFolder: Presentation
		lineageTag: b6e3e08c-3291-44ee-a408-f15ef74d3f14

	/// Dynamic subtitle of the page 1 monthly GMV line: GMV in context plus the note that YoY only exists for 2018. Text only; FORMAT uses en-US.
	measure 'GMV Monthly Subtitle' = "By purchase month | context GMV R$ " & FORMAT ( [GMV], "#,0", "en-US" ) & " | YoY only available for 2018"
		displayFolder: Presentation
		lineageTag: 21ddffb3-9be3-445a-8ba7-a837ffca9898

	/// Dynamic subtitle of the page 1 monthly Late Rate % line: Late Rate % in context. Text only; FORMAT uses en-US.
	measure 'Late Rate Monthly Subtitle' = "By purchase month | context rate " & FORMAT ( [Late Rate %], "0.0%", "en-US" )
		displayFolder: Presentation
		lineageTag: 92ba0f60-9e66-4aa1-bce7-03fc7a0845e2

	/// Dynamic subtitle of the page 1 Orders per 100k filled map: Orders per 100k in context. Text only; FORMAT uses en-US.
	measure 'Orders Map Subtitle' = "Orders per 100k pop. in context: " & FORMAT ( [Orders per 100k], "#,0.0", "en-US" )
		displayFolder: Presentation
		lineageTag: 95e4391b-c9b4-496e-88d4-1a27f399e622

	/// Dynamic subtitle of the page 1 top 10 Late Rate % bars: whether the worst 3 are highlighted (more than 3 eligible members). Text only; FORMAT uses en-US.
	measure 'Top10 Late Subtitle' = IF ( [Eligible Late States] > 3, "Worst 3 in orange | states with at least 30 evaluated orders", "No highlight: fewer than 4 states with at least 30 evaluated orders" )
		displayFolder: Presentation
		lineageTag: a53fc72e-ea7f-495e-8988-1c3e5c50588a

	/// Dynamic subtitle of the page 1 Late Rate Variance by region bars: target and Late Rate % in context, and the sign convention. Text only; FORMAT uses en-US.
	measure 'Region Variance Subtitle' = "Target " & FORMAT ( [Late Rate Target], "0%", "en-US" ) & " | context rate " & FORMAT ( [Late Rate %], "0.0%", "en-US" ) & " | + = better than target"
		displayFolder: Presentation
		lineageTag: 9d6c19d2-2163-4dda-96c9-59a0cca11f27

	/// Dynamic subtitle of the page 2 Avg Review by delay band columns: Avg Review in context. Text only; FORMAT uses en-US.
	measure 'Review Band Subtitle' = "Context average review: " & FORMAT ( [Avg Review], "0.00", "en-US" ) & " stars"
		displayFolder: Presentation
		lineageTag: c3b05bf1-b5b5-4112-bb4d-d0ee765b6b85

	/// Dynamic subtitle of the page 2 delay vs review scatter: Avg Delay Days and Avg Review in context. Text only; FORMAT uses en-US.
	measure 'Delay Review Scatter Subtitle' = "Average delay " & FORMAT ( [Avg Delay Days], "0.0", "en-US" ) & " days | average review " & FORMAT ( [Avg Review], "0.00", "en-US" )
		displayFolder: Presentation
		lineageTag: 1c2b2bc6-0367-4b0f-a5a8-b2f5e9416d1e

	/// Dynamic subtitle of the page 2 Avg Delay Days filled map: Avg Delay Days in context and the sign convention. Text only; FORMAT uses en-US.
	measure 'Delay Map Subtitle' = "Average delay " & FORMAT ( [Avg Delay Days], "0.0", "en-US" ) & " days (negative = early)"
		displayFolder: Presentation
		lineageTag: c0552d44-080b-487d-ba21-94e71af49990

	/// Dynamic subtitle of the page 2 weekday x purchase hour heatmap: Orders in context. Text only; FORMAT uses en-US.
	measure 'Heatmap Subtitle' = FORMAT ( [Orders], "#,0", "en-US" ) & " orders in context | purchase hour by weekday"
		displayFolder: Presentation
		lineageTag: 60514e87-a066-4acc-a4b1-1c7c43a008ef

	/// Dynamic subtitle of the page 2 Review Gap vs National bars: national Avg Review (customer geography filters removed) used as the reference of the gap. Text only; FORMAT uses en-US.
	measure 'Review Gap Subtitle' = "Context national review: " & FORMAT ( CALCULATE ( [Avg Review], REMOVEFILTERS ( dim_customer ), REMOVEFILTERS ( dim_state ) ), "0.00", "en-US" )
		displayFolder: Presentation
		lineageTag: ee7216c2-d00a-415d-b2a7-bea7814e7539

	/// Dynamic subtitle of the page 3 seller bubble map: GMV in context and the number of sellers without coordinates. Text only; FORMAT uses en-US.
	measure 'Sellers Map Subtitle' = "Context GMV R$ " & FORMAT ( [GMV], "#,0", "en-US" ) & " | " & [Sellers Without Coords Note]
		displayFolder: Presentation
		lineageTag: dd9d443e-c57c-49f3-87ff-826533da6312

	/// Dynamic subtitle of the page 3 macro category / category treemap: GMV in context. Text only; FORMAT uses en-US.
	measure 'Treemap Subtitle' = "Context GMV R$ " & FORMAT ( [GMV], "#,0", "en-US" )
		displayFolder: Presentation
		lineageTag: cf0ea99a-114d-49c8-9974-791b024f9535

	/// Dynamic subtitle of the page 3 distance vs freight ratio scatter: Avg Distance km and Freight Ratio in context. Text only; FORMAT uses en-US.
	measure 'Distance Scatter Subtitle' = "Average distance " & FORMAT ( [Avg Distance km], "#,0", "en-US" ) & " km | freight " & FORMAT ( [Freight Ratio], "0.0%", "en-US" ) & " of GMV"
		displayFolder: Presentation
		lineageTag: 3feb6801-3d11-4176-b75b-069b1e4c940c

	/// Dynamic subtitle of the page 3 100% stacked payment type columns: Orders in context. Text only; FORMAT uses en-US.
	measure 'Payment Mix Subtitle' = FORMAT ( [Orders], "#,0", "en-US" ) & " orders in context"
		displayFolder: Presentation
		lineageTag: 439d9aed-c9a9-41d6-a369-4c4f2c20ea91

	/// Dynamic subtitle of the page 3 top 10 categories table: GMV in context. Text only; FORMAT uses en-US.
	measure 'Top Categories Subtitle' = "Context GMV R$ " & FORMAT ( [GMV], "#,0", "en-US" ) & " | top 10 by GMV"
		displayFolder: Presentation
		lineageTag: 976ea7c0-c5a8-47de-ab46-95e6ad06f120

